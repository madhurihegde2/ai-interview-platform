PORT=3001

# Postgres with pgvector, from docker compose (host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_interview

JWT_SECRET=change-me

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Must produce 1536-dimension vectors to match the database column
EMBEDDING_MODEL=openai/text-embedding-3-small

# Kafka, from docker compose
KAFKA_BROKERS=localhost:9092

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Number of main questions per interview (follow-ups are added on top)
INTERVIEW_QUESTION_COUNT=5
