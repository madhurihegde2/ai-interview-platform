PORT=3001

# Postgres with pgvector, from docker compose (host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_interview

JWT_SECRET=change-me

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Comma-separated: first is used, the rest are fallbacks when it's busy.
# ":free" models cost nothing (OpenRouter limit: 50 requests/day, or
# 1000/day once you've purchased $10+ of credits)
OPENROUTER_MODEL=particle-ai/particle-1:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free
# Must support 1536-dimension output (the database column size).
# After changing it, run: npm run reembed
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free

# Kafka, from docker compose
KAFKA_BROKERS=localhost:9092

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Number of main questions per interview (follow-ups are added on top)
INTERVIEW_QUESTION_COUNT=5
